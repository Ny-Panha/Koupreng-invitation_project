[
  {
    "route": "/app/events",
    "owner": "EventsFeature",
    "css": "EventsFeature.css / scoped OwnerExperience.css",
    "states": [
      "loading",
      "empty",
      "offline local",
      "search",
      "filters",
      "sort",
      "page",
      "calendar"
    ]
  },
  {
    "route": "/app/events/new",
