+  transition: all 0.2s;
+}
+
+.venues-content .btn-search:hover {
+  background: var(--ui-theme-action-hover, #22332c);
+  transform: translateY(-1px);
+}
+
+/* Venue Grid Style */
+.venues-grid {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
+  gap: 32px;
+  margin-top: 16px;
+}
