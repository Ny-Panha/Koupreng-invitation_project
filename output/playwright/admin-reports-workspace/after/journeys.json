  "journeys": [
    {
      "name": "A - Find verified receipts",
      "start": "Reports / Executive summary",
      "actions": [
        "Select This month"
      ],
      "interactions": 1,
      "completion": "Both verified-currency totals are visible immediately",
      "confusingStates": [
        "Amounts are synthetic fixture totals, not live revenue."
      ],
      "accessibilityProblems": []
    },
    {
      "name": "B - Investigate a review transaction",
      "start": "Reports / Executive summary",
      "actions": [
        "Open Finance",
        "Choose Pending review",
        "Open record details"
      ],
      "interactions": 3,
      "completion": "Order identity, verification result and permitted audit fields are visible",
      "confusingStates": [
        "A supplemental UI-only pending-review fixture exercises this state; golden financial files remain unchanged."
      ],
      "accessibilityProblems": []
    },
    {
      "name": "C - Find an invitation",
      "start": "Reports / Payments",
      "actions": [
        "Open Events",
        "Type event title",
        "Submit search",
        "Choose Published",
        "Open record details"
      ],
      "interactions": 5,
      "completion": "The matching event is found and its full details can be inspected",
      "confusingStates": [],
      "accessibilityProblems": []
    },
    {
      "name": "D - Export all filtered records",
      "start": "Reports / Payments",
      "actions": [
        "Open More filters",
        "Choose USD",
        "Apply filters",
        "Open Export report",
        "Choose Download Excel"
      ],
      "interactions": 5,
      "completion": "A complete server-generated USD workbook downloads; the menu explains all-record scope",
      "confusingStates": [],
      "accessibilityProblems": []
    },
    {
      "name": "E - Print a filtered report",
      "start": "Reports / Payments, USD filter active",
      "actions": [
        "Open Export report",
        "Choose Print / Save as PDF",
        "Choose A4 portrait",
        "Print / Save as PDF",
        "Close preview"
      ],
      "interactions": 5,
      "completion": "Print dispatch and a real Chromium PDF are verified; report, filters and trigger focus are restored",
      "confusingStates": [
        "The OS print dialog is not automated. Native print invocation is intercepted, and the captured document is independently rendered to PDF."
      ],
      "accessibilityProblems": []
    }
  ],
  "states": [
    "export failed, with recovery",
    "export completed",
    "stale snapshot, export disabled",
    "permission denied, stale data removed",
    "empty filtered records, clear-filter recovery",
    "initial loading without invented zero metrics"
  ],
