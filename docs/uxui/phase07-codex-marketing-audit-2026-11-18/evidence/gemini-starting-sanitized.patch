+/* VenuesFeature.css - Luxury Cambodian Wedding Venue Discovery
+   Refined atelier aesthetic with champagne gold, warm ivory, deep evergreen ink,
+   and comprehensive dark mode support matching canonical --ui-theme-* tokens. */
+
+.venues-page-wrapper {
+  min-height: 100vh;
+  background-color: var(--ui-theme-canvas, #fbf6ee);
+  color: var(--ui-theme-ink, #1f2421);
+  font-family: var(--ui-font, 'Kantumruy Pro', sans-serif);
+  position: relative;
+  overflow-x: clip;
+}
+
+.venues-page-wrapper :is(button, input, a):focus-visible {
+  outline: 3px solid var(--ui-theme-focus, #0f766e);
+  outline-offset: 4px;
+}
+
+/* Background overlay */
+.venues-page-wrapper .fixed-bg-overlay {
+  position: fixed;
+  inset: 0;
+  z-index: 0;
+  pointer-events: none;
+}
+
+.venues-page-wrapper .bg-image {
+  width: 100%;
+  height: 100%;
+  background-size: cover;
+  background-position: center;
+  opacity: 0.15;
+}
+
+.venues-page-wrapper .bg-gradient-cover {
+  position: absolute;
+  inset: 0;
+  background: linear-gradient(
+    to bottom,
+    rgba(251, 246, 238, 0.4) 0%,
+    rgba(251, 246, 238, 0.95) 100%
+  );
+}
+
+:root[data-color-mode="dark"] .venues-page-wrapper .bg-gradient-cover {
+  background: linear-gradient(
+    to bottom,
+    rgba(23, 32, 25, 0.6) 0%,
+    rgba(23, 32, 25, 0.98) 100%
+  );
+}
+
+.venues-content {
+  position: relative;
+  z-index: 10;
+  padding: 140px 20px 100px;
+}
+
+.venues-content .container {
+  max-width: 1280px;
+  margin: 0 auto;
+}
+
+.venues-content .header-content {
+  text-align: center;
+  margin-bottom: 64px;
+}
+
+.venues-content .sub-title {
+  font-size: 12px;
+  font-weight: 700;
+  color: var(--ui-theme-gold, #926c34);
+  letter-spacing: 0.18em;
+  display: block;
+  margin-bottom: 12px;
+  text-transform: uppercase;
+}
+
+.venues-content .main-title {
