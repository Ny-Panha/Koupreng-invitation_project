{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Minimal portable evidence contracts. verify_evidence.py enforces IDs, required fields, stable denominators, hashes and link existence without adding application dependencies.",
  "$defs": {
    "acceptance": {
      "type": "object",
      "required": ["count", "counts", "criteria"],
      "properties": {
        "count": { "const": 26 },
        "criteria": {
          "type": "array", "minItems": 26, "maxItems": 26,
          "items": {
            "type": "object", "required": ["id", "gate", "verdict", "evidence"],
            "properties": {
              "id": { "pattern": "^F08\\.1-(0[1-9]|1[0-9]|2[0-6])$" },
              "verdict": { "enum": ["VERIFIED — LOCAL", "PARTIALLY COMPLETE", "REVIEW REQUIRED", "BLOCKED — EXTERNAL", "FAILED"] }
            }
          }
        }
      }
    },
    "defects": {
      "type": "array", "minItems": 13, "maxItems": 13,
      "items": {
        "type": "object", "required": ["id", "severity", "title", "source", "fix", "tests", "disposition"],
        "properties": {
          "id": { "pattern": "^C08-[0-9]{3}$" },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "command", "exitCode", "seconds", "head", "sourceFingerprint", "log"],
        "properties": {
          "exitCode": { "type": "integer" },
          "seconds": { "type": "number", "minimum": 0 },
          "head": { "pattern": "^[0-9a-f]{40}$" },
          "sourceFingerprint": { "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "carryover": {
      "type": "object", "required": ["entries", "newPhase08Items"],
      "properties": {
        "entries": { "type": "array", "minItems": 57, "maxItems": 57 },
        "newPhase08Items": { "type": "array", "minItems": 5, "maxItems": 5 }
      }
    },
    "routeState": {
      "type": "object", "required": ["surfaces", "stateCells", "statusCounts", "rows"],
      "properties": {
        "surfaces": { "const": 13 },
        "stateCells": { "const": 234 },
        "rows": { "type": "array", "minItems": 13, "maxItems": 13 }
      }
    }
  }
}
