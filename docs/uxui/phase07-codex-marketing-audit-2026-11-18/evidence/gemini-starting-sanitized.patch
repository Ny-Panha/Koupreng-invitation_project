+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  line-height: 1.5;
+}
+
+.gold-text-bold {
+  color: var(--ui-theme-gold, #926c34);
+  font-weight: 700;
+}
+
+.view-detail-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  padding: 12px 20px;
+  min-height: 48px;
