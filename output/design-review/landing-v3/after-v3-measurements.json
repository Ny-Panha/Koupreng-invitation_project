    "h2s": [
      {
        "text": "ម៉ឺនុយ",
        "fontSize": "20px",
        "lineHeight": "36px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(38, 38, 34)"
      },
      {
        "text": "ការអញ្ជើញមួយ។\nអនុស្សាវរីយ៍រាប់មិនអស់។",
        "fontSize": "40.32px",
        "lineHeight": "62.496px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(38, 38, 34)"
      },
      {
        "text": "ជ្រើសរើសគំរូដែលសាកសមនឹងថ្ងៃពិសេស",
        "fontSize": "40.32px",
        "lineHeight": "62.496px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(38, 38, 34)"
      },
      {
        "text": "ពីការជ្រើសរើស ដល់ការចែករំលែក",
        "fontSize": "40.32px",
        "lineHeight": "62.496px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(38, 38, 34)"
      },
      {
        "text": "រៀបចំពិធីដោយក្តីរីករាយ និងទំនុកចិត្ត",
        "fontSize": "40.32px",
        "lineHeight": "62.496px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(248, 245, 238)"
      },
      {
        "text": "រូបថតមួយ។ ឈ្មោះមួយ។\nអារម្មណ៍ដែលជារបស់អ្នក។",
        "fontSize": "40.32px",
        "lineHeight": "62.496px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(38, 38, 34)"
      },
      {
        "text": "មើលគំរូជាមុន\nជ្រើសរើសពេលអ្នករួចរាល់",
        "fontSize": "40.32px",
        "lineHeight": "62.496px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(38, 38, 34)"
      },
      {
        "text": "សំណួរតូចៗ។\nចម្លើយច្បាស់លាស់។",
        "fontSize": "40.32px",
        "lineHeight": "62.496px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(38, 38, 34)"
      },
      {
        "text": "ត្រៀមបង្កើតសន្លឹកការរបស់អ្នកហើយឬនៅ?",
