  "km-1440": {
    "title": "Koupreng - ធៀបការឌីជីថល (Digital Invitation)",
    "bodyBg": "rgb(247, 245, 251)",
    "bodyColor": "rgb(30, 41, 59)",
    "h1": {
      "text": "សន្លឹកការដ៏ប្រណីត\nសម្រាប់ថ្ងៃពិសេស។",
      "fontSize": "51.12px",
      "lineHeight": "84.348px",
      "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
      "color": "rgb(33, 24, 15)"
    },
    "headerHeight": 117,
    "h2s": [
      {
        "text": "ម៉ឺនុយ",
        "fontSize": "20px",
        "lineHeight": "36px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(33, 24, 15)"
      },
      {
        "text": "ការអញ្ជើញមួយ។\nអនុស្សាវរីយ៍រាប់មិនអស់។",
        "fontSize": "43.2px",
        "lineHeight": "69.12px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(33, 24, 15)"
      },
      {
        "text": "ធៀបការមួយ\nសម្រាប់រាល់អនុស្សាវរីយ៍។",
        "fontSize": "43.2px",
        "lineHeight": "69.12px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(33, 24, 15)"
      },
      {
        "text": "រឿងរ៉ាវរបស់អ្នក ចាប់ផ្តើមនៅទីនេះ។",
        "fontSize": "43.2px",
        "lineHeight": "69.12px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(33, 24, 15)"
      },
      {
        "text": "ការអញ្ជើញដោយក្តីស្រលាញ់។\nរៀបចំដោយភាពងាយស្រួល។",
        "fontSize": "43.2px",
        "lineHeight": "69.12px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(252, 248, 242)"
      },
      {
        "text": "រូបថតមួយ។ ឈ្មោះមួយ។\nអារម្មណ៍ដែលជារបស់អ្នក។",
        "fontSize": "43.2px",
        "lineHeight": "69.12px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(33, 24, 15)"
      },
      {
        "text": "មើលគំរូជាមុន។\nជ្រើសរើសពេលអ្នករួចរាល់។",
        "fontSize": "43.2px",
        "lineHeight": "69.12px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(33, 24, 15)"
      },
      {
        "text": "សំណួរតូចៗ។\nចម្លើយច្បាស់លាស់។",
        "fontSize": "43.2px",
        "lineHeight": "69.12px",
        "fontFamily": "\"Koupreng UI\", \"DM Sans\", \"Noto Sans Khmer\", sans-serif",
        "color": "rgb(33, 24, 15)"
      },
      {
        "text": "បង្កើតសន្លឹកការ\nដែលជារបស់អ្នក។",
