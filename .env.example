# Database
DB_URL=jdbc:mysql://localhost:3306/koupreng_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Phnom_Penh&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change_me
FLYWAY_BASELINE_ON_MIGRATE=true

# Backend URLs
BACKEND_BASE_URL=http://localhost:8080
SPRING_API_BASE_URL=http://localhost:8080
SPRING_PROFILES_ACTIVE=dev

# Local developer portal (documentation features are disabled by production defaults)
OPENAPI_ENABLED=true
SWAGGER_UI_ENABLED=true
SCALAR_ENABLED=true
SCALAR_PERSIST_AUTH=true
DEV_SAMPLE_DATA_ENABLED=true

# Frontend
VITE_API_URL=/api
VITE_PUBLIC_APP_URL=https://your-ngrok-domain.ngrok-free.dev

# JWT
JWT_SECRET=replace_with_a_random_64_character_or_longer_secret
JWT_ISSUER=koupreng-backend
JWT_ACCESS_TOKEN_MINUTES=15

# Google auth
GOOGLE_CLIENT_IDS=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs

# Telegram auth
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
TELEGRAM_EMAIL_DOMAIN=telegram.local
TELEGRAM_BOT_USERNAME=your_telegram_bot_username
TELEGRAM_CLIENT_ID=1234567890
TELEGRAM_JWK_SET_URI=https://oauth.telegram.org/.well-known/jwks.json
VITE_TELEGRAM_BOT_USERNAME=your_telegram_bot_username
VITE_TELEGRAM_BOT_ID=1234567890
VITE_TELEGRAM_CLIENT_ID=1234567890

# Account settings
FIRST_USER_ADMIN_ENABLED=false
PASSWORD_RESET_TOKEN_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:5173/reset-password
PASSWORD_RESET_EMAIL_FROM=no-reply@koupreng.local
PASSWORD_RESET_LOG_TOKEN_IN_DEVELOPMENT=false
EMAIL_VERIFICATION_TOKEN_MINUTES=1440
EMAIL_VERIFICATION_FRONTEND_URL=http://localhost:5173/verify-email
EMAIL_VERIFICATION_LOG_TOKEN_IN_DEVELOPMENT=false

# API security
CORS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://your-ngrok-domain.ngrok-free.dev
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With,X-Request-Id
CORS_EXPOSED_HEADERS=X-Request-Id
CORS_MAX_AGE_SECONDS=1800
CLIENT_ADDRESS_FORWARDED_HEADERS_ENABLED=false

# HTTPS / HSTS
HTTPS_REQUIRED=false
HSTS_ENABLED=true
HSTS_MAX_AGE_SECONDS=31536000

# API logging
API_LOGGING_ENABLED=true
API_LOGGING_INCLUDE_QUERY_STRING=false
API_LOGGING_INCLUDE_HEALTH_CHECKS=false

# Rate limiting
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REDIS_KEY_PREFIX=koupreng:rate-limit:
RATE_LIMIT_FAIL_CLOSED=true

# WAF layer
WAF_ENABLED=true
WAF_AUDIT_ONLY=false
WAF_PROTECTED_PATH_PREFIXES=/api
WAF_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
WAF_MAX_URI_LENGTH=2048
WAF_MAX_QUERY_LENGTH=2048
WAF_MAX_BODY_BYTES=65536
WAF_MAX_HEADER_VALUE_LENGTH=4096
WAF_MAX_HEADER_COUNT=80
WAF_MAX_REQUESTS_PER_MINUTE=120

# Upload validation
UPLOAD_MAX_FILE_SIZE=50MB
UPLOAD_MAX_REQUEST_SIZE=60MB
UPLOAD_VALIDATION_ENABLED=true
UPLOAD_MAX_FILE_SIZE_BYTES=52428800
UPLOAD_MAX_FILES=5
UPLOAD_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,application/pdf,video/mp4,video/webm,audio/mpeg,audio/mp3,audio/wav,audio/ogg,text/csv,application/csv,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/octet-stream
UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp,.pdf,.mp4,.webm,.mp3,.wav,.ogg,.csv,.xlsx
UPLOAD_VERIFY_SIGNATURES=true

# Local mail testing via Mailpit
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# Media storage
STORAGE_PROVIDER=local
LOCAL_UPLOAD_DIR=uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:8080/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=koupreng

# JWT cookie auth
AUTH_COOKIE_ENABLED=false
AUTH_COOKIE_NAME=koupreng_access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_HTTP_ONLY=true
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_MAX_AGE_SECONDS=900
CORS_ALLOW_CREDENTIALS=false
VITE_AUTH_STORAGE=localStorage

# ABA static KHQR template/package payments
ABA_PAYWAY_STATIC_LINK=https://link.payway.com.kh/replace_with_static_khqr_link
PAYMENT_PROVIDER_MODE=static
ADMIN_PAYMENT_SECRET=replace_with_random_admin_payment_secret
AUTO_CONFIRM_TELEGRAM_DETECTED=true
PAYMENT_ORDER_EXPIRY_MINUTES=60

# Telegram payment detection
TELEGRAM_ALLOWED_GROUP_IDS=
TELEGRAM_ALLOWED_ADMIN_IDS=
TELEGRAM_ALLOWED_PAYMENT_BOT_USERNAMES=PayWayByABA_bot
TELEGRAM_ALLOWED_PAYMENT_BOT_IDS=
