  "editable": {
    "cinematicIntro": true,
    "coverBackground": true,
    "heroPhoto": true,
    "gallery": true,
    "music": true,
    "colors": [
      "primary",
      "secondary",
      "background"
    ],
    "content": [
      "names",
      "parents",
      "eventDate",
      "eventTime",
      "venue",
      "schedule",
      "giftQr",
      "message",
      "rsvp"
    ],
    "sections": true
  }
