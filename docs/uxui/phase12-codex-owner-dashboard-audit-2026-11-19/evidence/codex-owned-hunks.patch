+/* Phase 12 owner chrome. Public pages, template renderers and admin are excluded. */
+.dash-wrapper {
+  --host-nav-offset: calc(80px + env(safe-area-inset-top, 0px));
+  background: var(--ui-theme-canvas);
+  color: var(--ui-theme-ink);
+}
+.dash-wrapper .host-header-wrapper { padding: 8px 0; background: var(--ui-theme-canvas); border: 0; box-shadow: none; backdrop-filter: none; }
+.dash-wrapper .host-header-container {
+  width: calc(100% - 32px); max-width: none; height: 64px; padding: 0 24px;
+  border-radius: 14px; border: 1px solid var(--ui-theme-border); background: var(--ui-theme-surface);
+  box-shadow: none; backdrop-filter: none; gap: 32px;
+}
+.dash-wrapper .host-nav-links { justify-content: flex-start; gap: 4px; }
+.dash-wrapper .host-nav-link { border-radius: 8px; font-size: 14px; padding-inline: 12px; font-weight: 600; color: var(--ui-theme-muted); }
+.dash-wrapper .host-nav-link.active { background: var(--ui-theme-action-soft); color: var(--ui-theme-action); border-color: transparent; }
+.dash-wrapper .host-logo-box:hover { transform: none; }
+.dash-wrapper .host-profile-menu { background: var(--ui-theme-surface); border-color: var(--ui-theme-border); box-shadow: var(--ui-theme-shadow); backdrop-filter: none; }
+.dash-wrapper .host-profile-menu-item { color: var(--ui-theme-ink); }
+.dash-wrapper .host-profile-menu-item:focus-visible { outline: 2px solid var(--ui-theme-focus); outline-offset: -2px; background: var(--ui-theme-subtle); }
+.dash-wrapper .host-profile-menu-item:hover { background: var(--ui-theme-subtle); color: var(--ui-theme-ink); }
+.dash-wrapper .host-profile-menu-item.logout { color: var(--ui-theme-danger); }
+.dash-wrapper .host-user-actions { gap: 12px; }
+.dash-wrapper :is(button,a,input,select,summary):focus-visible { outline: 3px solid var(--ui-theme-focus); outline-offset: 3px; }
+.dash-wrapper #host-main-content, .dash-wrapper #event-module-content { scroll-margin-top: var(--host-nav-offset); }
+
+/* A single document scroll keeps navigation and the active task in one hierarchy. */
+@media (min-width: 1024px) {
+  .dash-wrapper.dash-wrapper--event:not(.dash-wrapper--studio) { height: auto; min-height: 100dvh; overflow: visible; }
+  .dash-wrapper.dash-wrapper--event:not(.dash-wrapper--studio) > .dash-main-scroll { overflow: visible; }
+  .dash-wrapper .event-workspace:not(.is-studio) { height: auto; min-height: calc(100dvh - var(--host-nav-offset)); overflow: visible; align-items: start; padding-bottom: 32px; }
+  .dash-wrapper .event-workspace:not(.is-studio) .event-workspace-main { overflow: visible; padding: 0; }
+  .dash-wrapper .event-workspace:not(.is-studio) .event-workspace-sidebar { position: static; height: auto; }
+  .dash-wrapper .event-navigation-body { overflow: visible; scrollbar-gutter: auto; }
+}
+.dash-wrapper .event-workspace {
+  --event-nav-width: 240px; --ws-canvas: var(--ui-theme-canvas); --ws-surface: var(--ui-theme-surface);
+  --ws-ink: var(--ui-theme-ink); --ws-muted: var(--ui-theme-muted); --ws-border: var(--ui-theme-border);
+  --ws-border-strong: var(--ui-theme-control-border); --ws-surface-subtle: var(--ui-theme-subtle);
+  gap: 24px; padding-top: 8px;
+}
+.dash-wrapper .event-workspace.is-collapsed { --event-nav-width: 72px; }
+.dash-wrapper .event-workspace-sidebar { border-radius: 12px; box-shadow: none; }
+.dash-wrapper .event-navigation-header { padding: 16px 12px; }
+.dash-wrapper .event-context-eyebrow { font-size: 13px; margin-bottom: 8px; }
+.dash-wrapper .event-navigation-body { padding: 8px; }
+.dash-wrapper .event-nav-tab { border-radius: 8px; padding: 8px 10px; font-size: 14px; }
